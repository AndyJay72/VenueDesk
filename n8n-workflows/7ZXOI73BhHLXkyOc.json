      {
        "parameters": {
          "operation": "executeQuery",
          "query": "WITH bk AS (\n  SELECT cb.id, cb.customer_id, c.full_name, c.email, c.phone,\n         r.name AS room_name, cb.date_from, cb.start_time, cb.end_time\n  FROM bookings.confirmed_bookings cb\n  JOIN bookings.customers c ON c.id = cb.customer_id\n  LEFT JOIN bookings.rooms r ON r.id = cb.room_id\n  WHERE cb.id = $1::uuid AND cb.tenant_id = $3::integer\n  LIMIT 1\n)\nINSERT INTO bookings.customer_interactions (\n  tenant_id, customer_id, customer_name, customer_email, customer_phone,\n  booking_id, room_name, subject, interaction_type, notes, staff_member, timestamp\n)\nSELECT $3::integer, bk.customer_id, bk.full_name, bk.email, bk.phone,\n  bk.id, bk.room_name,\n  'Booking confirmed: ' || COALESCE(bk.room_name, '') || ' | ' || COALESCE(bk.date_from::text, ''),\n  'booking_confirmed',\n  $2,\n  'System', NOW()\nFROM bk\nRETURNING id;",
          "options": {
            "queryReplacement": "={{ [$('DB: Create Booking From Request').first().json.id || '', 'New booking created and confirmed', parseInt($('Webhook: Confirm Booking').first().json.body.tenant_id || $('Webhook: Confirm Booking').first().json.query?.tenant_id || '0')] }}"
          }
