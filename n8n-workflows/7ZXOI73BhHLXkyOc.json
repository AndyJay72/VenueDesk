        "parameters": {
          "operation": "executeQuery",
          "query": "INSERT INTO bookings.payments (booking_id, customer_id, amount, payment_type, payment_method, status, tenant_id, reference_number)\nSELECT $1::uuid, $2::uuid, $3::numeric, 'deposit', $4, 'received', $5::integer,\n       'DEP-' || TO_CHAR(NOW(), 'YYYYMMDDHH24MISS') || '-' || UPPER(SUBSTRING(MD5(RANDOM()::text), 1, 4))\nWHERE $3::numeric > 0",
          "options": {
            "queryReplacement": "={{ [\n  $('DB: Create Booking From Request').first().json.id,\n  $('Webhook: Confirm Booking').first().json.body.customer_id,\n  parseFloat($('Webhook: Confirm Booking').first().json.body.deposit_amount || '0'),\n  $('Webhook: Confirm Booking').first().json.body.payment_method || 'cash',\n  parseInt($('Webhook: Confirm Booking').first().json.body.tenant_id || $('Webhook: Confirm Booking').first().json.query?.tenant_id || '0')\n] }}"
          }
