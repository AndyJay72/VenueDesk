      {
        "id": "create-booking-001",
        "name": "DB: Create Booking From Request",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.5,
        "position": [
          680,
          180
        ],
        "parameters": {
          "operation": "executeQuery",
          "query": "WITH booking_data AS (\n  SELECT\n    br.customer_id,\n    br.room_id           AS primary_room_id,\n    br.requested_date::date,\n    COALESCE(br.date_from, br.requested_date)::date AS date_from,\n    COALESCE(br.date_to,   br.requested_date)::date AS date_to,\n    br.start_time,\n    br.end_time,\n    br.tenant_id,\n    COALESCE($3::numeric, 0) AS total_amount,\n    COALESCE($4::numeric, 0) AS balance_due\n  FROM bookings.booking_requests br\n  WHERE br.id = $1::uuid\n    AND br.customer_id = $2::uuid\n),\nroom_ids AS (\n  -- Use rooms JSON array from payload if provided, otherwise use the primary room from booking_requests\n  SELECT unnest(\n    CASE\n      WHEN $5::text IS NOT NULL AND $5::text <> '' AND $5::text <> '[]'\n        THEN ARRAY(SELECT (value->>'room_id')::uuid FROM json_array_elements($5::json))\n      ELSE ARRAY[(SELECT primary_room_id FROM booking_data)]\n    END\n  ) AS room_id\n)\nINSERT INTO bookings.confirmed_bookings\n  (customer_id, room_id, booking_date, date_from, date_to,\n   start_time, end_time, total_amount, balance_due, deposit_paid, status, tenant_id)\nSELECT\n  bd.customer_id,\n  ri.room_id,\n  bd.requested_date,\n  bd.date_from,\n  bd.date_to,\n  bd.start_time,\n  bd.end_time,\n  ROUND(bd.total_amount / NULLIF((SELECT COUNT(*) FROM room_ids), 0), 2),\n  ROUND(bd.balance_due  / NULLIF((SELECT COUNT(*) FROM room_ids), 0), 2),\n  0,\n  'deposit_pending',\n  bd.tenant_id\nFROM booking_data bd\nCROSS JOIN room_ids ri\nON CONFLICT DO NOTHING\nRETURNING id;",
          "options": {
            "queryReplacement": "={{ [\n  $json.body.request_id,\n  $json.body.customer_id,\n  $json.body.total_amount,\n  $json.body.balance_due,\n  JSON.stringify($json.body.rooms || [])\n] }}"
          }
        },
        "credentials": {
          "postgres": {
            "id": "XHopEzNBCVGCXpXV",
            "name": "Postgres account"
          }
        }
