      {
        "parameters": {
          "operation": "executeQuery",
          "query": "UPDATE bookings.confirmed_bookings\nSET\n  status       = 'booked',\n  total_amount = CASE WHEN $2::text IS NOT NULL AND $2::text <> 'null' AND $2::text <> '' THEN $2::numeric ELSE total_amount END,\n  balance_due  = CASE WHEN $3::text IS NOT NULL AND $3::text <> 'null' AND $3::text <> '' THEN $3::numeric ELSE balance_due END\nWHERE id = $1::uuid AND tenant_id = $4::integer;",
          "options": {
            "queryReplacement": "={{ $json.body.booking_id }},={{ $json.body.total_amount }},={{ $json.body.balance_due }},={{ parseInt($json.body.tenant_id || $json.headers?.['x-tenant-id'] || $json.query?.tenant_id || '0') }}"
          }
        },
