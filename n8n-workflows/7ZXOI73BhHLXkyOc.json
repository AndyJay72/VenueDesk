          "options": {
            "queryReplacement": "={{ [$('Webhook: Confirm Booking').first().json.body.request_id, $('Webhook: Confirm Booking').first().json.body.customer_id, parseInt($('Webhook: Confirm Booking').first().json.body.tenant_id || $('Webhook: Confirm Booking').first().json.headers?.['x-tenant-id'] || $('Webhook: Confirm Booking').first().json.query?.tenant_id || '0')] }}"
