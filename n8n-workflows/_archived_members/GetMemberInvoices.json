    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  mi.id,\n  mi.membership_id,\n  mi.customer_id,\n  mi.invoice_month::text,\n  mi.total_amount,\n  mi.amount_paid,\n  mi.balance_due,\n  mi.status,\n  mi.due_date::text,\n  mi.paid_at::text,\n  mi.notes,\n  mi.issued_at::text,\n  c.full_name AS customer_name\nFROM bookings.membership_invoices mi\nJOIN bookings.customers c ON c.id = mi.customer_id\nWHERE mi.membership_id = $1::uuid\n  AND mi.tenant_id = $2\nORDER BY mi.invoice_month DESC;",
        "options": {
          "queryReplacement": "={{ [\n  $('Webhook: Get Member Invoices').first().json.query?.membership_id || '',\n  parseInt($('Webhook: Get Member Invoices').first().json.query?.tenant_id || '0')\n] }}"
        }
      },
