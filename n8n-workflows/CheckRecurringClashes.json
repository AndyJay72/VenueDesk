      "position": [80, 200],
      "parameters": {
        "method": "POST",
        "url": "https://api.venuedesk.co.uk/recurring/check-clashes",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + ($('Webhook: Check Recurring Clashes').first().json.body?.jwt || '') }}"
