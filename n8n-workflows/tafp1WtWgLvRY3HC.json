        "jsCode": "const body = $input.first().json.body || $input.first().json;\n// Role verified via JWT token in Authorization header\nif (!body.room_id) throw new Error('room_id is required');\nif (!body.event_type_id) throw new Error('event_type_id is required');\nconst dayRate = parseFloat(body.day_rate);\nif (isNaN(dayRate) || dayRate < 0) throw new Error('day_rate must be a non-negative number');\nreturn {\n  json: {\n    room_id: body.room_id,\n    event_type_id: body.event_type_id,\n    day_rate: dayRate,\n    tenant_id: parseInt($input.first().json.headers?.['x-tenant-id'] || $input.first().json.query?.tenant_id || '0')\n  }\n};"
