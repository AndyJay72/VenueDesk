        "jsCode": "const body = $input.first().json.body || $input.first().json;\n// Role verified via JWT token in Authorization header\n\nif (!body.id) throw new Error('Room id is required');\nif (!body.name || body.name.trim() === '') throw new Error('Room name is required');\n\nconst dayRate = parseFloat(body.day_rate);\nif (isNaN(dayRate) || dayRate < 0) throw new Error('day_rate must be a non-negative number');\n\nconst halfRate = body.half_rate !== undefined && body.half_rate !== '' ? parseFloat(body.half_rate) : null;\nconst capacity = body.capacity && body.capacity !== '' ? parseInt(body.capacity, 10) : null;\n\nreturn {\n  json: {\n    id: body.id,\n    name: body.name.trim(),\n    capacity: capacity,\n    day_rate: dayRate,\n    half_rate: halfRate,\n    description: body.description ? body.description.trim() : null,\n    is_active: body.is_active !== false && body.is_active !== 'false'\n  }\n};"
