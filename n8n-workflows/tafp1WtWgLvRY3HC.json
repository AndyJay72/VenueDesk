    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst auth = $input.first().json.headers?.authorization || '';\n\n// Role check — admin/manager only\n// Role verified via JWT token in Authorization header\n\nif (!body.name || typeof body.name !== 'string' || body.name.trim() === '') {\n  throw new Error('Room name is required');\n}\n\nconst dayRate = parseFloat(body.day_rate);\nif (isNaN(dayRate) || dayRate < 0) {\n  throw new Error('day_rate must be a non-negative number');\n}\n\nconst halfRate = body.half_rate !== undefined && body.half_rate !== '' ? parseFloat(body.half_rate) : null;\nif (halfRate !== null && (isNaN(halfRate) || halfRate < 0)) {\n  throw new Error('half_rate must be a non-negative number if provided');\n}\n\nconst capacity = body.capacity && body.capacity !== '' ? parseInt(body.capacity, 10) : null;\n\nreturn {\n  json: {\n    name: body.name.trim(),\n    capacity: capacity,\n    day_rate: dayRate,\n    half_rate: halfRate,\n    description: body.description ? body.description.trim() : null,\n    tenant_id: parseInt($input.first().json.headers?.['x-tenant-id'] || $input.first().json.query?.tenant_id || '0')\n  }\n};"
      },
      "id": "90b83fbb-9393-43f0-a188-e7cb1b8d7b12",
      "name": "Code: Validate Room",
