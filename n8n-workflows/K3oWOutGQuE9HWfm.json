          "jsCode": "// Extract Form Data\nconst body = $input.first().json.body || $input.first().json;\n\nconst services = Array.isArray(body.services) ? body.services : [];\nconst rooms    = Array.isArray(body.rooms) ? body.rooms : [];\n\n// Calculate estimated cost: sum (room.day_rate * hours) + sum service subtotals\nconst timeFrom = body.timeFrom || '';\nconst timeTo   = body.timeTo   || '';\nlet hours = 0;\nif (timeFrom && timeTo) {\n  const [fh, fm] = timeFrom.split(':').map(Number);\n  const [th, tm] = timeTo.split(':').map(Number);\n  hours = Math.max(0, (th * 60 + tm - fh * 60 - fm) / 60);\n}\nconst roomCost     = rooms.reduce((s, r) => s + (parseFloat(r.day_rate || 0) * hours), 0);\nconst servicesCost = services.reduce((s, sv) => s + (parseFloat(sv.subtotal || sv.price || 0)), 0);\nconst estimatedCost = Math.round((roomCost + servicesCost) * 100) / 100;\n\n// Encode services & rooms into notes as a recoverable metadata block\nconst meta = JSON.stringify({ services, rooms, hours });\nconst rawNotes = body.notes || '';\nconst notes = rawNotes + (rawNotes ? '\\n' : '') + '##ENQUIRY_META##' + meta;\n\nreturn {\n  json: {\n    tenant_id: (body.tenant_id !== undefined && body.tenant_id !== null && body.tenant_id !== '') ? parseInt(body.tenant_id, 10) : null,\n    full_name: body.name,\n    email: body.email,\n    phone: body.contact,\n    event_type: body.eventType,\n    event_date: body.eventDate,\n    guests_count: body.numPeople || body.guest_count,\n    date_from: body.dateFrom || body.date_from || body.eventDate,\n    date_to: body.dateTo || body.date_to || body.dateFrom || body.eventDate,\n    guest_count: body.numPeople || body.guest_count,\n    time_from: body.timeFrom,\n    time_to: body.timeTo,\n    room_name: body.roomName,\n    notes: notes,\n    estimated_cost: estimatedCost,\n    timestamp: new Date().toISOString()\n  }\n};"
