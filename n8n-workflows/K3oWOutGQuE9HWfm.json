    {
      "parameters": {
        "jsCode": "// Find room_id matching the room_name from the enquiry form\nconst rooms = $json.data || [];\nconst roomName = $('Code: Extract Data').first().json.room_name || '';\nconst matched = rooms.find(r => r.name.toLowerCase() === roomName.toLowerCase());\nif (!matched) throw new Error('Room not found: ' + roomName);\nreturn { json: { id: matched.id, name: matched.name } };"
      },
