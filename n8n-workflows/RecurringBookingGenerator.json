{
  "name": "VenueDesk - Monthly Recurring Booking Generator",
  "nodes": [
    {
      "id": "6206cac6-d56e-4af4-bf2a-0bd6f26d3cd1",
      "name": "Schedule: 1st of Month",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        -1200,
        144
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 1 * *"
            }
          ]
        }
      }
    },
    {
      "id": "8535ca01-5af6-47bc-8620-eedc1b7a47ae",
      "name": "Code: Explode Dates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -720,
        144
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// For each active rule, generate all matching weekday dates in the target month.\nconst items = $input.all();\nconst today = new Date();\ntoday.setHours(0,0,0,0);\n\n// Target = next calendar month\nconst tY = today.getMonth() === 11 ? today.getFullYear() + 1 : today.getFullYear();\nconst tM = today.getMonth() === 11 ? 0 : today.getMonth() + 1;\nconst mStart = new Date(tY, tM, 1);\nconst mEnd   = new Date(tY, tM + 1, 0); // last day of target month\n\nconst out = [];\nfor (const item of items) {\n  const rule = item.json;\n  const dow  = parseInt(rule.day_of_week); // 0=Sun \u2026 6=Sat\n  let cur = new Date(mStart);\n  while (cur <= mEnd) {\n    if (cur.getDay() === dow) {\n      const ds = cur.toISOString().split('T')[0];\n      out.push({ json: {\n        ...rule,\n        booking_date: ds,\n        target_month: mStart.toISOString().split('T')[0]\n      }});\n    }\n    cur.setDate(cur.getDate() + 1);\n  }\n}\nreturn out;"
      }
    },
    {
      "id": "cf9249a7-f42e-441d-aae8-e9b0a16ed36d",
      "name": "IF: No Conflict",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -240,
        144
      ],
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.conflict_count }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "0"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "79e4d2f3-e8a3-41bd-bd1a-236d5f61e01a",
      "name": "Email: Monthly Invoice",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        720,
        0
      ],
      "continueOnFail": true,
      "parameters": {
        "fromEmail": "bookings@venuedesk.co.uk",
        "toEmail": "={{ $('Code: Explode Dates').item.json.customer_email }}",
        "subject": "={{ 'Monthly Membership Invoice \u2013 ' + new Date($('Code: Explode Dates').item.json.target_month).toLocaleString('en-GB',{month:'long',year:'numeric'}) }}",
        "emailFormat": "html",
        "html": "=<p>Dear {{ $('Code: Explode Dates').item.json.customer_name }},</p>\n<p>Your membership invoice for <strong>{{ new Date($('Code: Explode Dates').item.json.target_month).toLocaleString('en-GB',{month:'long',year:'numeric'}) }}</strong> is ready.</p>\n<table style=\"width:100%;border-collapse:collapse;font-size:14px;margin-bottom:16px\">\n  <tr style=\"background:#f3f4f6\"><th align=\"left\" style=\"padding:8px\">Plan</th><td style=\"padding:8px\">{{ $('Code: Explode Dates').item.json.plan_name }}</td></tr>\n  <tr><th align=\"left\" style=\"padding:8px\">Room</th><td style=\"padding:8px\">{{ $('Code: Explode Dates').item.json.room_name }}</td></tr>\n  <tr style=\"background:#f3f4f6\"><th align=\"left\" style=\"padding:8px\">Amount Due</th><td style=\"padding:8px\"><strong>\u00a3{{ parseFloat($('DB: Upsert Monthly Invoice').item.json.total_amount).toFixed(2) }}</strong></td></tr>\n  <tr><th align=\"left\" style=\"padding:8px\">Payment Due By</th><td style=\"padding:8px\">{{ $('DB: Upsert Monthly Invoice').item.json.due_date }}</td></tr>\n</table>\n<p style=\"font-size:13px;color:#555\">{{ $('DB: Get Policy Terms').item.json.base_terms }}</p>\n{{ $('DB: Get Policy Terms').item.json.extra_clauses ? '<p style=\"font-size:13px;border-left:3px solid #4f46e5;padding-left:10px\">'+$('DB: Get Policy Terms').item.json.extra_clauses+'</p>' : '' }}\n<p>Questions? Email <a href=\"mailto:bookings@venuedesk.co.uk\">bookings@venuedesk.co.uk</a></p>\n<p>Best regards,<br>The VenueDesk Team</p>",
        "options": {
          "appendAttribution": false
        }
      }
    },
    {
      "id": "0a27d669-d44f-424b-bfc8-91aec4f3b1db",
