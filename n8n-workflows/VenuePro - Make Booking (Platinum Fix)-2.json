    {
      "parameters": {
        "jsCode": "// 1. GET INPUTS\nconst webhookItem = $('Webhook: Receive Booking').first().json;\nconst input = webhookItem.body || webhookItem;\nconst room = $('DB: Get Room').first().json;\nconst customerData = $input.first().json;\n\n// 2. VALIDATION\nif (!room || !room.data?.id) throw new Error(\"Room not found for id: \" + (input.room_id || 'unknown'));\nconst customerId = customerData.data?.id;\nif (!customerId) throw new Error(\"Customer could not be resolved: \" + (customerData.message || JSON.stringify(customerData)));\nif (!input.booking_date) throw new Error(\"booking_date missing from request.\");\n\n// 3. TRUST FRONTEND-CALCULATED AMOUNTS\nconst total_amount = parseFloat(input.total_amount) || 0;\nif (isNaN(total_amount) || total_amount < 0) {\n  throw new Error(\"Invalid total_amount received: \" + input.total_amount);\n}\n\nconst isPending = input.status === 'pending' || input.payment_type === 'none';\nconst pType = isPending ? 'none' : (input.payment_type === 'full' || input.payment_type === 'full_payment') ? 'full' : 'deposit';\nlet payment_amount = parseFloat(input.payment_amount) || 0;\nif (!isPending) {\n  if (isNaN(payment_amount) || payment_amount <= 0) {\n    throw new Error(\"Invalid payment_amount received: \" + input.payment_amount);\n  }\n}\nif (pType === 'full') payment_amount = total_amount;\nif (isPending) payment_amount = 0;\n\nconst balance = total_amount - payment_amount;\nconst status = isPending ? 'pending' : (balance <= 0.01 ? 'fully_paid' : 'deposit_paid');\n\n// 4. GENERATE REFS\nconst txnRef = 'TXN-' + Math.floor(100000 + Math.random() * 900000);\nconst startDateTime = input.booking_date + 'T' + input.start_time + ':00';\nconst endDateTime   = input.booking_date + 'T' + input.end_time   + ':00';\n\nreturn {\n  json: {\n    ...input,\n    customer_id:        customerId,\n    room_id:            room.data?.id,\n    total_amount:       parseFloat(total_amount.toFixed(2)),\n    payment_amount:     parseFloat(payment_amount.toFixed(2)),\n    balance_due:        parseFloat(balance.toFixed(2)),\n    booking_status:     status,\n    payment_type_clean: pType,\n    payment_date:       new Date().toISOString(),\n    txn_reference:      txnRef,\n    request_id:         (input.request_id && input.request_id !== \"\") ? input.request_id : null,\n    google_start:       startDateTime,\n    google_end:         endDateTime\n  }\n};"
      },
