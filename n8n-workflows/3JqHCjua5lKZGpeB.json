        "parameters": {
          "operation": "executeQuery",
          "query": "CREATE TABLE IF NOT EXISTS bookings.blocked_dates (id SERIAL PRIMARY KEY, block_type VARCHAR(20) NOT NULL, day_of_week INT, block_date DATE, date_from DATE, date_to DATE, label VARCHAR(255), created_by VARCHAR(255), created_at TIMESTAMP DEFAULT NOW())",
