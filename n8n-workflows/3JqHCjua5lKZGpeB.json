      {
        "parameters": {
          "operation": "executeQuery",
          "query": "INSERT INTO bookings.blocked_dates (block_type, day_of_week, block_date, date_from, date_to, label, created_by, tenant_id) VALUES ($1,$2,$3,$4,$5,$6,$7,$8) RETURNING *",
