            "queryReplacement": "={{ [$json.body.block_type, ($json.body.day_of_week !== undefined ? $json.body.day_of_week : null), $json.body.block_date || null, $json.body.date_from || null, $json.body.date_to || null, $json.body.label || '', $json.body.created_by || 'staff', parseInt($json.headers?.['x-tenant-id'] || $json.query?.tenant_id || '0')] }}"
