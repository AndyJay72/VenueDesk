      {
        "parameters": {
          "operation": "executeQuery",
          "query": "SELECT * FROM bookings.blocked_dates WHERE tenant_id = $1::integer ORDER BY block_type, day_of_week NULLS LAST, block_date NULLS LAST, date_from NULLS LAST",
          "options": {
            "queryReplacement": "={{ [parseInt($json.headers?.['x-tenant-id'] || $json.query?.tenant_id || '0')] }}"
