idate Reset').first().json;\nreturn { json: { username: validated.username, hashed_password: hash } };"},"id":"5c7ad43d-c929-408c-a8c8-dd6186a4bf97","name":"Code: Build Reset Params","type":"n8n-nodes-base.code","typeVersion":2,"position":[840,1080]},{"parameters":{"operation":"executeQuery","query":"\nUPDATE bookings.staff_users\nSET    hashed_password = $2\nWHERE  username = $1\nRETURNING id, username;\n","options":{"queryReplacement":"={{ [$json.username, $json.hashed_password] }}"}},"id":"059f7c80-8245-45bc-98dc-148684b546a6","name":"DB: Reset Password","type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[1120,1080],"credentials":{"postgres":{"id":"XHopEzNBCVGCXpXV","name":"Postgres account"}}},{"parameters":{"respondWith":"json","responseBody":"={{ JSON.stringify({ ok: true }) }}","options":{"responseHeaders":{"entries":[{"name":"Access-Control-Allow-Origin","value":"*"}]}}},"id":"5a3a96d9-2054-40b8-89fa-bb0dc58563c6","name":"Respond: Reset OK","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.1,"position":[1400,1080]},{"parameters":{"path":"onboarding/toggle-venue","responseMode":"responseNode","options":{},"authentication":"none","httpMethod":"POST"},"id":"ea4b808f-8ae9-4483-a3a6-1e48d2fbe65b","name":"Webhook: Toggle Venue","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[0,1440],"webhookId":"onboarding/toggle-venue"},{"parameters":{"jsCode":"const body = $input.first().json.body || $input.first().json;\nconst tenantId = parseInt(body.tenant_id, 10);\nif (!tenantId) throw new Error('tenant_id is required');\nreturn { json: { tenant_id: tenantId } };"},"id":"4faf7490-f913-4954-aabe-1223a0d9df07","name":"Code: Validate Toggle","type":"n8n-nodes-base.code","typeVersion":2,"position":[280,1440]},{"parameters":{"operation":"executeQuery","query":"\nUPDATE bookings.tenants\nSET    active = NOT active\nWHERE  tenant_id = $1\nRETURNING tenant_id, name, active;\n","options":{"queryReplacement":"={{ [$json.tenant_id] }}"}},"id":"2c96fef7-d431-41c1-aef8-6064020e61a5","name":"DB: Toggle Venue","type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[560,1440],"credentials":{"postgres":{"id":"XHopEzNBCVGCXpXV","name":"Postgres account"}}},{"parameters":{"respondWith":"json","responseBody":"={{ JSON.stringify({ ok: true, data: [$json] }) }}","options":{"responseHeaders":{"entries":[{"name":"Access-Control-Allow-Origin","value":"*"}]}}},"id":"dfcad6df-5bd0-4e84-a2ea-624053cb7575","name":"Respond: Toggle OK","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.1,"position":[840,1440]},{"id":"24cf384a-2f80-46b1-8563-a0ed53c3fe21","name":"Webhook: Update Venue","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[200,1100],"parameters":{"path":"onboarding/update-venue","authentication":"none","responseMode":"responseNode","options":{},"httpMethod":"POST"}},{"id":"d7f5c90b-0f79-4f2b-b42d-16ae8a1346bd","name":"DB: Update Venue Details","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[460,1100],"parameters":{"operation":"executeQuery","query":"UPDATE bookings.tenants SET name = CASE WHEN $1 <> '' THEN $1 ELSE name END, slug = CASE WHEN $2 <> '' THEN $2 ELSE slug END WHERE tenant_id = $3; UPDATE bookings.staff_users SET full_name = CASE WHEN $4 <> '' THEN $4 ELSE full_name END WHERE tenant_id = $3;","options":{"queryReplacement":"={{ [$json.body.venue_name || '', $json.body.slug || '', parseInt($json.body.tenant_id, 10), $json.body.full_name || ''] }}"}},"credentials":{"postgres":{"id":"XHopEzNBCVGCXpXV","name":"Postgres account"}}},{"id":"0f43380f-d870-4e34-a5bc-608bfc940d79","name":"Respond: Updated","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.1,"position":[700,1100],"parameters":{"respondWith":"json","responseBody":"{\"ok\": true}","options":{}}}],"connections":{"Webhook: Admin Login":{"main":[[{"node":"Code: Check Admin Key","type":"main","index":0}]]},"Code: Check Admin Key":{"main":[[{"node":"Respond: Auth OK","type":"main","index":0}]]},"Webhook: List Venues":{"ma