    {
      "parameters": {
        "jsCode": "return [{ json: ($input.first().json.data || $input.first().json) }];",
        "mode": "runOnceForAllItems"
      },
      "id": "bct-flat-dec",
      "name": "DB: Decrement Remaining Cycles",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "continueOnFail": true,
      "position": [
