    {
      "id": "e4643c43-4904-4096-a9c8-1c62c5ac4891",
      "name": "Email: Send Expiry Warning",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [224, 0],
      "parameters": {
        "fromEmail": "bookings@venuedesk.co.uk",
        "toEmail": "={{ $json.body.customer_email }}",
        "subject": "=Your venue enquiry expires in {{ $json.body.days_left }} day(s) — VenueDesk",
        "emailFormat": "html",
        "html": "=<p>Hi {{ $json.body.customer_name }},</p><p>Your venue enquiry expires in <strong>{{ $json.body.days_left }} day(s)</strong>. Please contact us to confirm your booking before it expires.</p><p><strong>Event:</strong> {{ $json.body.event_type }}<br><strong>Room:</strong> {{ $json.body.room_name || \"TBC\" }}<br><strong>Date:</strong> {{ $json.body.event_date }}</p><p>The VenueDesk Team</p>",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "smtp": {
          "id": "J0qWHzypu4SvoXyg",
          "name": "Hostinger SMTP"
        }
      },
      "continueOnFail": true
    },
    {
      "id": "9a0bcc3f-b416-4bb4-bcc6-8948a5d50a19",
      "name": "Respond: Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [448, 0],
      "parameters": {
        "respondWith": "json",
        "responseBody": {
          "success": true,
          "message": "Expiry warning sent"
        }
      }
    }
  ],
  "connections": {
