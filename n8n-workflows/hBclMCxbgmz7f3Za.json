    {
      "parameters": {
        "jsCode": "const getSafeData = (nodeName, key) => {\n  try {\n    const resp = $(nodeName).first().json;\n    const arr = resp.data || resp;\n    if (key) return Array.isArray(arr) ? arr : (arr[key] || []);\n    return Array.isArray(arr) ? arr : [];\n  } catch (e) { return []; }\n};\n\nconst metricsResp = $('DB: Dash Metrics').first().json;\nconst metrics = metricsResp.data || metricsResp;\n\nconst outstandingResp = $('DB: Outstanding (Dashboard)').first().json;\nconst outstandingArr = Array.isArray(outstandingResp.data) ? outstandingResp.data : [];\n\nreturn {\n  json: {\n    data: {\n      metrics: {\n        total_revenue_month: metrics.total_revenue_month || 0,\n        outstanding: metrics.outstanding || 0,\n        pending_requests: metrics.pending_requests || 0\n      },\n      recent_customers: getSafeData('DB: Recent'),\n      upcoming_bookings: getSafeData('DB: Upcoming'),\n      outstanding: outstandingArr\n    }\n  }\n};"
      },
