    {
      "parameters": {
        "jsCode": "// Sanitize and validate input\nconst input = $input.first().json.body || $input.first().json;\n\nif (!input.id) throw new Error('Missing Customer ID');\n\nconst allowedStatuses = ['pending', 'contacted', 'booked', 'cancelled', 'completed'];\nconst status = input.status || 'contacted';\nif (!allowedStatuses.includes(status)) throw new Error('Invalid status value: ' + status);\n\n// id is a UUID string - do NOT convert to Number (would give NaN)\nreturn { json: { id: input.id, staff_name: input.staff_name || 'Manager', status, tenant_id: parseInt(input.tenant_id || $input.first().json.headers?.['x-tenant-id'] || $input.first().json.query?.tenant_id || '0') } };\n"
      },
      "id": "4ae6db33-a636-4aa9-9880-a52cb58c8ce4",
      "name": "Code: Sanitize Status",
